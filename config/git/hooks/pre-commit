#!/usr/bin/env bash
# Pre-commit hook — scan staged changes for secrets using gitleaks
# Docs: https://github.com/gitleaks/gitleaks#pre-commit-hook
#
# Install: copy this file to .git/hooks/pre-commit in any repo
#   cp config/git/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use core.hooksPath to share hooks across repos:
#   git config --global core.hooksPath /path/to/dotfiles/config/git/hooks
#
# The hook is NON-BLOCKING by default — it warns but does not abort commits.
# To make it blocking, set GITLEAKS_BLOCK=true in your environment.

set -euo pipefail

# Allow per-repo opt-out via a git config flag
if git config --bool hooks.gitleaks.disabled 2>/dev/null | grep -q true; then
  exit 0
fi

# Check if gitleaks is installed
if ! command -v gitleaks &>/dev/null; then
  echo "⚠  gitleaks no encontrado — hook omitido."
  echo "   Instalalo: brew install gitleaks"
  exit 0
fi

# Determine mode: block or warn
BLOCK_MODE="${GITLEAKS_BLOCK:-false}"
EXIT_CODE=0

echo "🔍 gitleaks: escaneando staged changes..."

# Run gitleaks protect on staged changes
# --staged: only scan what's about to be committed
# --no-banner: suppress gitleaks ASCII banner
# --config: use repo's .gitleaks.toml if it exists, otherwise use embedded defaults
if [ -f .gitleaks.toml ]; then
  gitleaks protect --staged --no-banner --config .gitleaks.toml --verbose 2>&1 || EXIT_CODE=$?
else
  gitleaks protect --staged --no-banner --verbose 2>&1 || EXIT_CODE=$?
fi

if [ "$EXIT_CODE" -ne 0 ]; then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "⚠  SECRETOS DETECTADOS en staged changes"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  if [ "$BLOCK_MODE" = "true" ]; then
    echo "❌ Commit BLOQUEADO. Revisa los leaks arriba."
    echo ""
    echo "   Si es un falso positivo, agregalo al allowlist en .gitleaks.toml"
    echo "   Si necesitas saltar el hook esta vez: git commit --no-verify"
    exit 1
  else
    echo "⚠  Modo WARN: commit permitido pero REVISA los leaks."
    echo "   Para bloquear commits con secretos: export GITLEAKS_BLOCK=true"
    echo ""
    echo "   Si es un falso positivo, agregalo al allowlist en .gitleaks.toml"
    exit 0
  fi
fi

echo "✅ gitleaks: sin secretos detectados."
