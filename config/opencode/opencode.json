{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "sebastian": {
      "mode": "primary",
      "description": "Senior Architect — orchestration, code quality, security-first",
      "temperature": 0.1,
      "prompt": "{file:./prompts/sebastian.txt}",
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow",
        "skill": "allow",
        "task": {
          "*": "allow"
        },
        "webfetch": "allow",
        "delegate": "allow",
        "delegation_read": "allow",
        "delegation_list": "allow"
      },
      "instructions": [
        "~/.config/opencode/AGENTS.md",
        "~/.config/opencode/security_rules.md",
        "~/.config/opencode/rules/npm-security.md"
      ]
    }
  },
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 60000
  },
  "default_agent": "sebastian",
  "small_model": "opencode/deepseek-v4-flash-free",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local",
      "environment": {
        "ENGRAM_CLOUD_AUTOSYNC": "1",
        "ENGRAM_CLOUD_TOKEN": "engram-local-token-32chars-xxxxx",
        "ENGRAM_CLOUD_SERVER": "http://localhost:18080"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "unity": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcpforunityserver",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ],
      "enabled": false
    },
    "resolve": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "$HOME/Developer/resolve-claude-mcp",
        "run",
        "resolve-claude-mcp"
      ],
      "enabled": false,
      "environment": {
        "RESOLVE_SCRIPT_LIB": "/Applications/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so",
        "RESOLVE_SCRIPT_API": "/Applications/DaVinci Resolve.app/Contents/Resources/Developer/Scripting",
        "PYTHONPATH": "/Applications/DaVinci Resolve.app/Contents/Resources/Developer/Scripting/Modules/"
      }
    }
  },
  "permission": {
    "bash": {
      "sudo *": "deny",
      "npm install -g*": "deny",
      "pip install --break-system-packages*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "kubectl delete*": "deny",
      "helm uninstall*": "deny",
      "helm delete*": "deny",
      "terraform destroy*": "deny",
      "terraform apply *-auto-approve*": "deny",
      "npm install*": "ask",
      "npm i *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git rebase*": "ask",
      "git clean*": "ask",
      "git checkout -f*": "ask",
      "rm -rf *": "ask",
      "rm -f *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git checkout*": "allow",
      "git branch*": "allow",
      "git log*": "allow",
      "git stash*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "bun *": "allow",
      "yarn *": "allow",
      "eza*": "allow",
      "fd *": "allow",
      "bat *": "allow",
      "rg *": "allow",
      "sd *": "allow",
      "which *": "allow",
      "brew *": "allow",
      "python *": "allow",
      "pip *": "allow",
      "uvx *": "allow",
      "uv *": "allow",
      "cargo *": "allow",
      "rustc *": "allow",
      "go *": "allow",
      "make *": "allow",
      "docker *": "allow",
      "gh *": "allow",
      "code *": "allow",
      "nvim *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "chmod *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "cd *": "allow",
      "env": "allow",
      "export *": "allow",
      "source *": "allow",
      "pytest *": "allow",
      "jest *": "allow",
      "vitest *": "allow",
      "ng *": "allow",
      "nx *": "allow",
      "turbo *": "allow",
      "*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/id_*": "deny",
      "**/.git/hooks/**": "deny",
      "**/.git/objects/**": "deny",
      "**/.DS_Store": "deny",
      "**/Thumbs.db": "deny",
      "**/.svn/**": "deny",
      "**/.hg/**": "deny",
      "**/CVS/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.ppk": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.pvk": "deny",
      "**/secrets/**": "deny",
      "**/credentials.json": "deny",
      "**/node_modules/**": "deny"
    },
    "write": {
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-worktree@latest"
  ]
}
