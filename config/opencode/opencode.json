{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "sebastian": {
      "mode": "primary",
      "description": "Senior Architect — orchestration, code quality, security-first",
      "temperature": 0.1,
      "prompt": "{file:./prompts/sebastian.txt}",
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow",
        "skill": "allow",
        "task": {
          "*": "allow"
        },
        "webfetch": "allow",
        "delegate": "allow",
        "delegation_read": "allow",
        "delegation_list": "allow"
      },
      "instructions": [
        "~/.config/opencode/AGENTS.md",
        "~/.config/opencode/security_rules.md",
        "~/.config/opencode/rules/npm-security.md"
      ]
    }
  },
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 60000
  },
  "default_agent": "sebastian",
  "small_model": "opencode/deepseek-v4-flash-free",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local",
      "environment": {
        "ENGRAM_CLOUD_AUTOSYNC": "1",
        "ENGRAM_CLOUD_TOKEN": "${ENGRAM_CLOUD_TOKEN}",
        "ENGRAM_CLOUD_SERVER": "http://100.75.235.85:18080"
      }
    },
    "blender": {
      "type": "local",
      "command": [
        "uvx",
        "blender-mcp"
      ],
      "enabled": false
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "sudo *": "deny",
      "npm install -g*": "deny",
      "pip install --break-system-packages*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "kubectl delete*": "deny",
      "helm uninstall*": "deny",
      "helm delete*": "deny",
      "terraform destroy*": "deny",
      "terraform apply *-auto-approve*": "deny",
      "git commit*": "ask",
      "git push*": "ask",
      "git rebase*": "ask",
      "git clean*": "ask",
      "git checkout -f*": "ask",
      "rm -rf *": "ask",
      "rm -f *": "ask",
      "*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/id_*": "deny",
      "**/.git/hooks/**": "deny",
      "**/.git/objects/**": "deny",
      "**/.DS_Store": "deny",
      "**/Thumbs.db": "deny",
      "**/.svn/**": "deny",
      "**/.hg/**": "deny",
      "**/CVS/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.ppk": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.pvk": "deny",
      "**/secrets/**": "deny",
      "**/credentials.json": "deny",
      "**/node_modules/**": "deny"
    },
    "write": {
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-worktree@latest",
    "@warp-dot-dev/opencode-warp"
  ]
}
