# Dynamic theme colors
config-file = ?"themes/catppuccin-mocha.conf"

# Fuente
font-family = "FiraCode Nerd Font Mono"
font-style = Regular
font-size = 13

# Ventana
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat
window-save-state = always

# Acceso rápido global
keybind = global:cmd+alt+enter=toggle_quick_terminal

# Ícono de macOS
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = "#FDFDFD"
macos-icon-screen-color = "#0F0F0F"

# Cursor
cursor-style = "block"
cursor-style-blink = false

# Integración del shell y sesiones SSH
shell-integration = detect
shell-integration-features = no-cursor,ssh-env

# Notificaciones y progreso para comandos largos/agents
desktop-notifications = true
progress-style = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

macos-option-as-alt = left
# Mantiene @ con Option izquierda en el teclado Latin American.
keybind = alt+q=text:@

# Atajos básicos
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u

# Divisiones: crear, navegar y redimensionar
keybind = alt+v=new_split:right
keybind = alt+d=new_split:down
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+j=resize_split:down,10
keybind = ctrl+shift+k=resize_split:up,10
keybind = ctrl+shift+l=resize_split:right,10

# Desplazamiento del mouse
mouse-scroll-multiplier = 0.95

# Integración con nvim
keybind = alt+s=write_screen_file:paste
keybind = ctrl+shift+s=write_scrollback_file:paste

# Limpiar pantalla
keybind = super+ctrl+k=clear_screen

# Ajustes de la ventana
window-padding-color = extend
window-padding-balance = true

# Apariencia
background-opacity = 0.80
background-blur-radius = 20
background-opacity-cells = true
background-blur = 40
custom-shader = shaders/cursor_smear_gentleman.glsl
custom-shader-animation = true
gtk-tabs-location = hidden

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
