{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3,
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_MAX_FILE_READ_BYTES": "500000",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_RETRIES": "2",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_HIDE_CWD": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "MAX_THINKING_TOKENS": "10000",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ENABLE_TOOL_SEARCH": "true",
    "BASH_MAX_OUTPUT_LENGTH": "30000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "25000",
    "ENGRAM_CLOUD_AUTOSYNC": "1",
    "CAVEMAN_DEFAULT_MODE": "ultra"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: none, solo developer on the personal GitHub account sebitabravo. Primary use of Claude Code: software development and personal dotfiles management on macOS across several projects",
      "Source control: additionally trusted are repos owned by github.com/sebitabravo. Forks and clones of third-party repos are not trusted, even when they sit under this account",
      "Normal workflow: pushing feature branches and opening pull requests in own repos, importing shell, editor, terminal and tool configs from $HOME into the dotfiles repo, and running the repo installer (install.sh) to apply dotfiles into $HOME",
      "Sensitive data locations: SSH private keys (id_rsa, id_ed25519 and similar), ~/.aws, ~/.netrc, ~/.config/gh/hosts.yml, shell history, ~/.claude session transcripts, auth and token files that tools keep under ~/.config or ~/.<tool>, plus .env* and credentials.json. Never print, commit or send these anywhere",
      "CI secrets GITHUB_TOKEN and ZAI_CODING_PLAN_KEY must never be echoed, written to files, or passed to any workflow step or destination other than their current use. Workflow edits that touch secrets are not routine",
      "Security hooks and their tests (config/claude/hooks, secret-detect): edits that disable, loosen or skip them need the user to ask for that explicitly. Test fixtures with fake secrets are fine",
      "Other agent CLIs on this machine (codex, opencode, kilo, copilot, cursor) are personal tools and are not trusted to bypass any rule"
    ]
  },
  "model": "opusplan",
  "fallbackModel": ["sonnet", "haiku"],
  "showClearContextOnPlanAccept": true,
  "promptSuggestionEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-safe-ops.sh",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-codegraph-tracking.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/privacy-review.sh",
            "timeout": 5,
            "if": "Bash(gh *)",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/quality-gate.sh",
            "timeout": 150,
            "if": "Bash(git commit *)"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-tests.sh",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/user-prompt-dispatcher.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-auto-save-stash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/handoff-session-start.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/compact-resume.py"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"systemMessage\":\"Contexto compactado. Las reglas de rules/common siguen vigentes; el protocolo de reanudacion se reinyecta en SessionStart (compact-resume.py).\"}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/detect-debug.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/handoff-stop.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v engram >/dev/null 2>&1; then engram save \"Session checkpoint\" \"Session ended at $(date -u +%Y-%m-%dT%H:%M:%SZ) in $PWD\" --type discovery --project session-checkpoints 2>/dev/null || true; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "engram@engram": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "spanish",
  "outputStyle": "Sebita",
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "fileCheckpointingEnabled": true
}
