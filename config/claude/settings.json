{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3,
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1024000",
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1",
    "CLAUDE_CODE_MAX_RETRIES": "2",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_HIDE_CWD": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "MAX_THINKING_TOKENS": "10000",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ENABLE_TOOL_SEARCH": "true",
    "BASH_MAX_OUTPUT_LENGTH": "30000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "25000",
    "ENGRAM_CLOUD_AUTOSYNC": "1",
    "CAVEMAN_DEFAULT_MODE": "ultra"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Edit",
      "Skill",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(yarn:*)",
      "Bash(eza:*)",
      "Bash(fd:*)",
      "Bash(bat:*)",
      "Bash(rg:*)",
      "Bash(sd:*)",
      "Bash(which:*)",
      "Bash(pip:*)",
      "Bash(uvx:*)",
      "Bash(uv:*)",
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(code:*)",
      "Bash(nvim:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(export:*)",
      "Bash(source:*)",
      "Bash(pytest:*)",
      "Bash(jest:*)",
      "Bash(vitest:*)",
      "Bash(ng:*)",
      "Bash(nx:*)",
      "Bash(turbo:*)",
      "WebFetch",
      "mcp__codegraph__*",
      "mcp__context7__*",
      "mcp__playwright__*",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm audit:*)",
      "Bash(npm run audit:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run check:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm run audit:*)",
      "Bash(bun test:*)",
      "Bash(bun run test:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run build:*)",
      "Bash(bun run check:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bun audit:*)",
      "Bash(bun run audit:*)",
      "Bash(yarn test:*)",
      "Bash(yarn run test:*)",
      "Bash(yarn run lint:*)",
      "Bash(yarn run build:*)",
      "Bash(yarn run check:*)",
      "Bash(yarn run typecheck:*)",
      "Bash(yarn audit:*)",
      "Bash(yarn run audit:*)",
      "Bash(uv run pytest:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo build:*)",
      "Bash(cargo audit:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(make test:*)",
      "Bash(make check:*)",
      "Bash(make lint:*)",
      "Bash(ng test:*)",
      "Bash(ng build:*)",
      "Bash(ng lint:*)",
      "Bash(nx test:*)",
      "Bash(nx build:*)",
      "Bash(nx lint:*)",
      "Bash(turbo test:*)",
      "Bash(turbo build:*)",
      "Bash(turbo lint:*)"
    ],
    "deny": [
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.development)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials.json)",
      "Read(**/node_modules/**)",
      "Read(**/.DS_Store)",
      "Read(**/Thumbs.db)",
      "Read(**/.svn/**)",
      "Read(**/.hg/**)",
      "Read(**/CVS/**)",
      "Read(**/.git/objects/**)",
      "Read(**/.git/hooks/**)",
      "Bash(npm install -g:*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Edit(**/.ssh/**)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/Library/Keychains/**)",
      "Read(~/.aws/credentials)",
      "Edit(~/.aws/credentials)",
      "Read(**/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/credentials.json)",
      "Edit(**/secrets/**)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "Edit(**/id_ecdsa)",
      "Edit(**/.netrc)",
      "Edit(~/.gnupg/**)",
      "Edit(**/*.ppk)",
      "Edit(**/*.pvk)",
      "Edit(**/id_dsa)",
      "Edit(**/id_ed25519_sk)",
      "Edit(**/id_ecdsa_sk)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.ppk)",
      "Read(**/*.pvk)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ed25519_sk)",
      "Read(**/id_ecdsa_sk)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.docker/config.json)",
      "Read(**/.kube/config)",
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf ~)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm exec:*)",
      "Bash(npm publish:*)",
      "Bash(pip install:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(brew:*)",
      "Bash(docker:*)",
      "Bash(gh:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-safe-ops.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-codegraph-tracking.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/privacy-review.sh",
            "timeout": 5,
            "if": "Bash(gh *)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/quality-gate.sh",
            "timeout": 150,
            "if": "Bash(git commit *)"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-tests.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/user-prompt-dispatcher.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-auto-save-stash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/handoff-session-start.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/compact-resume.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/project-integrations-check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"systemMessage\":\"Contexto compactado. Las reglas de CLAUDE.md siguen vigentes; el protocolo de reanudacion se reinyecta en SessionStart (compact-resume.py).\"}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/detect-debug.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[PostToolUseFailure] Tool call fallo — revisar si requiere cambio de estrategia' >&2",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/qa-checklist.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/automatic-workflow-stop.sh",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/gauntlet-stop.sh",
            "timeout": 100
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/convergence-stop.sh",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-check-pending.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/handoff-stop.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v engram >/dev/null 2>&1; then engram save \"Session checkpoint\" \"Session ended at $(date -u +%Y-%m-%dT%H:%M:%SZ) in $PWD\" --type discovery --project session-checkpoints 2>/dev/null || true; fi"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/task-contract.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/task-contract.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "engram@engram": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    }
  },
  "outputStyle": "Sebita",
  "language": "spanish",
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": true,
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "fileCheckpointingEnabled": true
}
