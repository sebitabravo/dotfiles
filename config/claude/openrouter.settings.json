{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "~/.claude/scripts/openrouter-api-key.sh",
  "env": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ENABLE_TOOL_SEARCH": "false",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ANTHROPIC_MODEL": "fable",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "openai/gpt-5.6-luna-pro[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "qwen/qwen3.8-flash[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "z-ai/glm-5.3-flash[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "openrouter/free",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1048576"
  }
}
