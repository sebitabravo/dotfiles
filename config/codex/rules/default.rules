# Codex rules govern commands that would otherwise run outside the sandbox.
# Keep this layer mechanical; behavioral guidance belongs in AGENTS.md.

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Remote writes need explicit approval.",
    match = ["git push", "git push origin main"],
    not_match = ["git status", "git push-not-a-command"],
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "prompt",
    justification = "Rewriting history needs explicit approval.",
)

prefix_rule(
    pattern = ["git", "reset"],
    decision = "prompt",
    justification = "Reset can discard work; confirm the exact target first.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Never discard working-tree changes automatically; inspect the diff and recover manually.",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Never delete untracked files automatically; inspect and remove an exact target manually.",
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Force-push can rewrite remote history; use a normal push or obtain an explicit human decision outside automation.",
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "prompt",
    justification = "Installing dependencies changes the environment and may run lifecycle scripts.",
)

prefix_rule(
    pattern = ["npm", "i"],
    decision = "prompt",
    justification = "Installing dependencies changes the environment and may run lifecycle scripts.",
)

prefix_rule(
    pattern = ["pip", "install"],
    decision = "prompt",
    justification = "Installing Python dependencies changes the environment.",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "prompt",
    justification = "Elevated privileges require explicit approval.",
)
