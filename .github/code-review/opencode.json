{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.3-flash",
  "permission": {
    "skill": {
      "*": "deny"
    }
  },
  "agent": {
    "review": {
      "description": "Read-only code review agent for GGA CI in dotfiles. Never edits files, never runs commands, never fetches the web.",
      "mode": "primary",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "webfetch": "deny"
      }
    }
  },
  "provider": {
    "zai-coding-plan": {
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3 Flash",
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" }
          }
        }
      }
    }
  },
  "_comment": "GLM-5.3 Flash: cheap multimodal, 3x quota on GLM Coding Plan (docs.z.ai/guides/vlm/glm-5.3-flash)."
}
