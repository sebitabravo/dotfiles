# Ignorar backups
*.backup.*

# Ignorar archivos de macOS
.DS_Store
.AppleDouble
.LSOverride

# Ignorar archivos temporales
*.tmp
*.swp
*.swo
*~

# No versionar claves privadas SSH
**/.ssh/id_*
**/.ssh/*.pem
**/.ssh/*.key

# No versionar información sensible
.env
.env.local
secrets/

# Archivos específicos de usuario que no deben compartirse
.vscode/
*.local.json
*.local.env
*.log

# Node.js (scripts de validacion, plugins)
node_modules/
package-lock.json
bun.lock
__pycache__/

# Handoff — traspaso entre sesiones (NUNCA commitear)
HANDOFF.md
HANDOFF.md.archived

# Roadmap del workflow automatico - estado de sesion, no un artefacto versionado
TASK-ROADMAP.md
task-roadmap.md

# Suites de verificacion dentro de directorios administrados: se corren en
# local, no se versionan.
#
# install.sh copia los directorios administrados (config/claude/**, etc.) pero
# excluye `*.test.sh`, asi que esas suites nunca llegan al runtime de quien usa
# la config. .github/test.sh no vive dentro de ningun directorio administrado
# -- install.sh nunca lo copia a ningun HOME -- asi que se versiona y corre en
# CI (.github/workflows/).
#
# El costo asumido: en un clone, validate.sh reporta las etapas de suite
# *.test.sh como omitidas. Las nombra igual en vez de callarlas, porque una
# etapa que no corrio no es una que paso.
*.test.sh
config/claude/scripts/test-swarmforge-workflow.sh
Makefile

# Planificacion y herramientas propias: no son parte de la configuracion que se
# instala. specs/ son artefactos SDD locales (Hard Rule 8) y tools/ es un banco
# de pruebas de CLIs de proveedores, util para desarrollar esto, no para usarlo.
# Anclados a la raiz con `/` para no tapar un tools/ dentro de config/.
/specs/
/tools/

# IA
.playwright-mcp/
.claude-rdd/
.codegraph/
.claude/
.opencode/
.codex/
.claude-relaxed
.atl
