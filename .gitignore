# Ignorar backups
*.backup.*

# Ignorar archivos de macOS
.DS_Store
.AppleDouble
.LSOverride

# Ignorar archivos temporales
*.tmp
*.swp
*.swo
*~

# No versionar claves privadas SSH
**/.ssh/id_*
**/.ssh/*.pem
**/.ssh/*.key

# No versionar información sensible
.env
.env.local
secrets/

# Archivos específicos de usuario que no deben compartirse
.vscode/
*.local.json
*.local.env
*.log

# Node.js (scripts de validacion, plugins)
node_modules/
package-lock.json
bun.lock
__pycache__/

# Handoff — traspaso entre sesiones (NUNCA commitear)
HANDOFF.md
HANDOFF.md.archived

# Suites de verificacion: se corren en local, no se versionan.
# run-all-tests.sh las ejecuta si estan presentes y reporta la etapa omitida
# si no lo estan, para no confundir "no corrio" con "paso".
*.test.sh
config/claude/scripts/test-swarmforge-workflow.sh

# IA
.playwright-mcp/
.claude-rdd/
.codegraph/
.claude/
.opencode/
.codex/
.claude-relaxed
.atl
