# Ignorar backups
*.backup.*

# Ignorar archivos de macOS
.DS_Store
.AppleDouble
.LSOverride

# Ignorar archivos temporales
*.tmp
*.swp
*.swo
*~

# No versionar claves privadas SSH
**/.ssh/id_*
**/.ssh/*.pem
**/.ssh/*.key

# No versionar información sensible
.env
.env.local
secrets/

# Archivos específicos de usuario que no deben compartirse
.vscode/
*.local.json
*.local.env
*.log

# Node.js (scripts de validacion, plugins)
node_modules/
package-lock.json
bun.lock
__pycache__/

# Las skills gestionadas de Claude sí versionan su lockfile para reproducir
# dependencias locales con el Node existente, sin instalar paquetes globales.
!config/claude/skills/pptx/package-lock.json
!config/claude/skills/stitch-react-components/package-lock.json

# Handoff — traspaso entre sesiones (NUNCA commitear)
HANDOFF.md
HANDOFF.md.archived

# Roadmap del workflow automatico — estado de sesion, no un artefacto versionado
TASK-ROADMAP.md
task-roadmap.md

# Todos los tests viven en .github/test/ (versionado, corre en CI). No hace
# falta ignorar *.test.sh en ningun directorio administrado: ninguno vuelve a
# tener suites propias, asi que no hay nada que install.sh deba excluir por
# convencion de nombre. El --exclude='*.test.sh' de install.sh queda igual,
# como defensa en profundidad, no porque algo lo necesite hoy.
config/claude/scripts/test-swarmforge-workflow.sh

# Planificacion y herramientas propias: no son parte de la configuracion que se
# instala. specs/ son artefactos SDD locales (Hard Rule 8) y tools/ es un banco
# de pruebas de CLIs de proveedores, util para desarrollar esto, no para usarlo.
# Anclados a la raiz con `/` para no tapar un tools/ dentro de config/.
/specs/
/tools/
/openspec/

# IA
.playwright-mcp/
.claude-rdd/
.codegraph/
.claude/
.opencode/
.codex/
.claude-relaxed
.atl
Makefile
