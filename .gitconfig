[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[core]
	commentChar = "#"
	pager = delta
	excludesFile = ~/.gitignore_global
	hooksPath = ~/.git-hooks

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[init]
	defaultBranch = main

[color]
	ui = auto
	diff = auto
	status = auto
	branch = auto
	interactive = auto

[alias]
	graph = log --oneline --graph --all
	ls = !eza --git --group-directories-first --icons=auto
	ll = !eza --git --group-directories-first --icons=auto -l
	la = !eza --git --group-directories-first --icons=auto -la
	co = checkout
	br = branch
	ci = commit
	st = status

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[commit]
	verbose = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[rerere]
	enabled = true
	autoupdate = true

# Identidad (nombre/email/signingkey) en ~/.gitconfig.local, fuera del repo.
# Crearlo al instalar en una maquina nueva — ver docs/MANUAL_INSTALL.md.
# VA AL FINAL A PROPOSITO: git aplica en orden de lectura y gana el ultimo, asi
# que desde aca ~/.gitconfig.local puede sobrescribir cualquier clave de arriba,
# no solo agregar identidad.
[include]
	path = ~/.gitconfig.local
