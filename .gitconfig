[user]
	# Cambia estos valores por los tuyos (o setealos con: git config --global user.name "..." && git config --global user.email "...")
	name = Tu Nombre
	email = tu-email@ejemplo.com
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	commentChar = "#"
	pager = delta
	excludesFile = ~/.gitignore_global
	hooksPath = ~/.git-hooks

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[init]
  defaultBranch = main
[color]
  ui = auto
  diff = auto
  status = auto
  branch = auto
  interactive = auto
[alias]
	graph = log --oneline --graph --all
	ls = !eza --git --group-directories-first --icons
  ll = !eza --git --group-directories-first --icons -l
  la = !eza --git --group-directories-first --icons -la
